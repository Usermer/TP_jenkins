pipeline{
    agent any
    stages{
        stage('Clonage'){
            steps{
                git branch: 'main', url: 'https://github.com/Usermer/TP_jenkins'
            }
        }
        stage('verification python'){
            steps{
                bat 'python --version'
                bat 'python -m pip --version'
            }
        }
        stage('Installation des dependances'){
            steps{
                bat 'pip install -r requirements.txt'
            }
        }
        stage('Tests unitaires'){
            steps{
                bat 'python -m pytest'
            }
        }
    }
    post{
        always{
            echo 'Pipeline termine'
        }
        failure{
            echo 'BUILD FAILURE'
        }
        success{
            echo 'BUILD SUCCESS'
        }
    }
}